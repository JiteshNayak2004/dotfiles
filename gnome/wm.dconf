[keybindings]
activate-window-menu=@as []
close=['<Alt>q']
cycle-windows=['<Alt>Tab']
cycle-windows-backward=['<Shift><Alt>Tab']
maximize=@as []
minimize=@as []
move-to-workspace-1=['<Alt>F1']
move-to-workspace-2=['<Alt>F2']
move-to-workspace-3=['<Alt>F3']
move-to-workspace-4=['<Alt>F4']
panel-run-dialog=@as []
switch-input-source=['XF86Keyboard']
switch-input-source-backward=['<Shift>XF86Keyboard']
switch-to-workspace-1=['<Alt>1']
switch-to-workspace-2=['<Alt>2']
switch-to-workspace-3=['<Alt>3']
switch-to-workspace-4=['<Alt>4']
switch-to-workspace-5=['<Alt>5']
switch-to-workspace-6=['<Alt>6']
switch-to-workspace-7=['<Alt>7']
switch-to-workspace-8=['<Alt>8']
switch-to-workspace-9=['<Alt>9']
switch-to-workspace-left=['<Alt>h']
switch-to-workspace-right=['<Alt>l']
switch-windows=@as []
switch-windows-backward=@as []
toggle-fullscreen=['<Super>f']
toggle-maximized=['<Super>m', '<Alt>F10']
unmaximize=@as []

[preferences]
num-workspaces=9
