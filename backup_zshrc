# fzf terminal integration (prefers ~/.fzf/bin 0.67 over system 0.29)
export PATH="$HOME/.fzf/bin:$PATH"
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git 2>/dev/null || rg --files --hidden -g "!.git" 2>/dev/null'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git 2>/dev/null || find . -type d 2>/dev/null'
export FZF_DEFAULT_OPTS='--height 40% --reverse --border --multi --info=inline'
# free Ctrl-S / Ctrl-Q from XON/XOFF flow control so they reach fzf/nvim
[[ -t 0 ]] && stty -ixon 2>/dev/null
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# ---------------------------------------------------------------------------
# Machine-specific settings: PATHs and env live in machines/<hostname>.zsh
# (tracked per machine, no secrets). Falls back to machines/default.zsh.
# Machine-local credentials live in ~/.config/zsh/dotfiles-secrets.zsh,
# which is never tracked in this repository.
# ---------------------------------------------------------------------------
_zsh_self="${(%):-%x}"
[[ -L "$_zsh_self" ]] && _zsh_self="$(readlink -f "$_zsh_self")"
_machines_dir="${_zsh_self:h}/machines"
if [[ -f "$_machines_dir/${(%):-%m}.zsh" ]]; then
  source "$_machines_dir/${(%):-%m}.zsh"
elif [[ -f "$_machines_dir/default.zsh" ]]; then
  source "$_machines_dir/default.zsh"
fi
unset _zsh_self _machines_dir

[ -f "$HOME/.config/zsh/dotfiles-secrets.zsh" ] && source "$HOME/.config/zsh/dotfiles-secrets.zsh"
